# Required — validated at build time by @Stratford-city-motorcars-Ltd/env/web
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Canonical origin. Drives canonical tags, Open Graph URLs, sitemap.xml and
# robots.txt. Defaults to https://www.stratfordcitymotorcars.com.
NEXT_PUBLIC_SITE_URL=https://www.stratfordcitymotorcars.com

# Where website enquiries are delivered.
#
# Until this is set the forms validate correctly and then honestly report that
# they could not be sent, offering the phone and WhatsApp instead — a lead that
# silently vanishes is worse than one that never submitted. Any endpoint that
# accepts a JSON POST works. See src/lib/forms/leads.ts
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_TOKEN=
