# ============================================================================
# Stratford City Motorcars — web app environment
# Copy to apps/web/.env. Never commit real values.
# ============================================================================

# ---- Public (exposed to the browser) ----------------------------------------

# Canonical origin. Drives canonical tags, Open Graph URLs, sitemap.xml and
# robots.txt. Defaults to https://www.stratfordcitymotorcars.com.
NEXT_PUBLIC_SITE_URL=https://www.stratfordcitymotorcars.com

# Legacy Better-T-Stack setting (the separate apps/server API). Optional for
# the website; validated as a URL at build time when set.
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# ---- Database (server only) -------------------------------------------------

# Postgres connection string. When set, the database is the single source of
# truth for inventory and website enquiries are stored in it. When unset, the public site runs from the read-only
# seed records and forms can only deliver through the webhook below.
# Build and runtime must use the same value.
DATABASE_URL=

# ---- Enquiry notifications (server only) ------------------------------------

# Any endpoint that accepts a JSON POST (Zapier, Make, n8n, a CRM). Use it to
# send the business an email and SMS for every enquiry until a dedicated email
# and SMS provider is chosen. See src/lib/leads/notify.ts.
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_TOKEN=

# ---- Media storage (server only) --------------------------------------------

# Where uploaded vehicle photographs and videos are kept on local disk.
# Defaults to apps/web/.data/media. Must be persistent in production.
MEDIA_ROOT=
# Set only when media moves to object storage behind a CDN (see
# src/lib/media/storage.ts); also allows that host in next/image.
MEDIA_PUBLIC_BASE_URL=

# ---- Online reservations (server only, off) ---------------------------------

# Provider-hosted checkout for reservation deposits. Ignored unless
# site.reservations is enabled in src/lib/site.ts. See src/lib/reservations.ts.
RESERVATION_CHECKOUT_URL=
