# ============================================================================
# Stratford City Motorcars — website environment
# Copy to apps/web/.env. Never commit real values.
# ============================================================================

# ---- Public (visible in the browser) ----------------------------------------

# Canonical origin. Drives canonical tags, Open Graph URLs, sitemap.xml and
# robots.txt. Defaults to https://www.stratfordcitymotorcars.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# The API server, kept from the starter kit. Optional: the website reads stock
# from the database directly and does not call it.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---- Database (server only) -------------------------------------------------

# The same Postgres as the API server, so cars published in the admin appear
# here and website enquiries land in the admin. Without it the site runs from
# the read-only seed records. Build and runtime must use the same value.
DATABASE_URL=

# ---- Photographs (server only) ----------------------------------------------

# Where /media/... requests go when the file is not on local disk: the API
# server, which serves photographs from object storage.
MEDIA_PROXY_ORIGIN=http://localhost:3000

# Local folder for media. Defaults to apps/web/.data/media.
MEDIA_ROOT=
# Set only when photographs are served from a public CDN host; also allows that
# host in next/image.
MEDIA_PUBLIC_BASE_URL=

# ---- Stock cache refresh (server only) --------------------------------------

# Lets the API refresh cached stock and business settings the moment they
# change. Must match the API server's REVALIDATE_SECRET (24+ characters);
# without it /api/revalidate is switched off and changes take up to 5 minutes.
REVALIDATE_SECRET=

# ---- Enquiry notifications (server only) ------------------------------------

# Email the dealership through Resend. All three are needed to switch it on.
RESEND_API_KEY=
EMAIL_FROM=
ENQUIRY_EMAIL_TO=

# Any endpoint that accepts a JSON POST (Zapier, Make, n8n, a CRM) — used for
# text messages until an SMS provider is chosen. See src/lib/leads/notify.ts.
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_TOKEN=

# ---- Online reservations (server only, switched off) ------------------------

# Provider-hosted checkout for reservation deposits. Ignored unless
# site.reservations is enabled in src/lib/site.ts.
RESERVATION_CHECKOUT_URL=
