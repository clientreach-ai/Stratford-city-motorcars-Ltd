# ============================================================================
# Stratford City Motorcars — API server environment
# Copy to apps/server/.env. Never commit real values.
# ============================================================================

# Postgres (the same database as the website).
DATABASE_URL=

# Better Auth. The secret must be at least 32 random characters.
BETTER_AUTH_SECRET=
# Public URL of this API server.
BETTER_AUTH_URL=http://localhost:3000
# Browser origins allowed to call the API with cookies (comma-separated):
# the website and the admin.
CORS_ORIGIN=http://localhost:3001,http://localhost:3002
PORT=3000

# ---- Admin ------------------------------------------------------------------
# Where the admin runs; invitation links point here.
ADMIN_URL=http://localhost:3002
# Email (Resend). Used for team invitations and, with ENQUIRY_EMAIL_TO, to tell
# the dealership about new website enquiries. Unset in development: invitation
# links are printed to the server console instead.
RESEND_API_KEY=
EMAIL_FROM=
# Where new enquiries are emailed, e.g. the dealership's own inbox.
ENQUIRY_EMAIL_TO=

# ---- Media uploads (Cloudflare R2 or any S3-compatible bucket) ---------------
UPLOAD_BUCKET=
UPLOAD_REGION=auto
UPLOAD_ACCESS_KEY_ID=
UPLOAD_SECRET_ACCESS_KEY=
# S3 API endpoint: https://<account-id>.r2.cloudflarestorage.com
UPLOAD_ENDPOINT=
# Where browsers load the files from: the bucket's public r2.dev URL or a
# custom domain (the website and admin then need it in MEDIA_PUBLIC_BASE_URL).
# Leave unset (or set to the private r2.cloudflarestorage.com endpoint) to
# record photos as /media/... and serve them through this API; the website
# then needs MEDIA_PROXY_ORIGIN pointing here.
UPLOAD_PUBLIC_BASE_URL=

# ---- Enquiry notifications (optional) -----------------------------------------
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_TOKEN=

# ---- Website cache refresh (optional) -----------------------------------------
# Lets stock edits appear on the website immediately instead of within 5 minutes.
# REVALIDATE_SECRET must match the website's value (24+ characters).
WEB_REVALIDATE_URL=http://localhost:3001/api/revalidate
REVALIDATE_SECRET=
